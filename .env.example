# Supabase (create project at supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Formaloo
FORMALOO_API_KEY=your_formaloo_api_key
FORMALOO_API_SECRET=your_formaloo_api_secret_base64
FORMALOO_FORM_SLUG=CGQse2u9
FORMALOO_WORKSPACE=cHQuChHR

# Google Drive (optional)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_DRIVE_FOLDER_ID=your_folder_id

# remove.bg (optional — BG removal now runs in browser)
REMOVE_BG_API_KEY=

# QR redirect base — the domain printed into QR codes (set in Netlify env)
# Production: https://link.reviewtap.co.za/r
VITE_QR_BASE_URL=
