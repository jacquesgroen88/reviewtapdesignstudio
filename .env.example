# ── Backend ──────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000

# remove.bg API key — get one at https://www.remove.bg/api
REMOVE_BG_API_KEY=your_remove_bg_api_key_here

# Google Drive — paste the full JSON content of your service account key
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Google Drive folder ID (the folder where TIFFs should be uploaded)
# Share this folder with your service account email (give it Editor access)
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here
